# Copy to .env.local and fill in. .env.local is never committed.

# Postgres. Locally: the docker-compose.yml database. In production: the RDS
# database and user created for this site.
DATABASE_URL=postgres://peyyala:peyyala@localhost:5432/peyyala

# Admin sign-in (Better Auth + Google)
# A long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different one in production, and keep it secret.
BETTER_AUTH_SECRET=
# The site's own address: http://localhost:3000 locally, https://peyyala.com live
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed into the admin
ADMIN_EMAIL=

# Uploaded files (screenshots, the resume PDF): see src/server/storage.ts
# "local" saves them in STORAGE_DIR and serves them at /uploads. S3 comes with
# the move to AWS.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Only for S3: the bucket's public address, so next/image accepts its images
# STORAGE_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Email about new contact messages: see src/server/mail.ts
# "console" prints each email in the server's terminal. "resend" sends it
# through Resend (resend.com); its test sender only delivers to the address
# the Resend account was made with.
MAIL_DRIVER=console
# Where the emails go. Empty means ADMIN_EMAIL.
MAIL_TO=
# Only for resend
RESEND_API_KEY=
MAIL_FROM=Portfolio <onboarding@resend.dev>
