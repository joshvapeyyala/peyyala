# Copy to .env.local and fill in. .env.local is never committed.

# Postgres. Locally: the docker-compose.yml database. In production: the RDS
# database and user created for this site.
DATABASE_URL=postgres://peyyala:peyyala@localhost:5432/peyyala

# Admin sign-in (Better Auth + Google)
# A long random string that signs session cookies (and keys the contact form's
# hashed visitor ids). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different one in production, and keep it secret. Changing it signs
# everyone out.
BETTER_AUTH_SECRET=
# The site's own address: http://localhost:3000 locally, https://peyyala.com live
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed into the admin
ADMIN_EMAIL=

# Uploaded files (screenshots, the resume PDF): see src/server/storage.ts
# "local" saves them in STORAGE_DIR and serves them at /uploads. S3 comes with
# the move to AWS.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Only for S3: the bucket's public address, so next/image accepts its images
# STORAGE_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# Email about new contact messages: see src/server/mail.ts
# "console" prints each email in the server's terminal. "resend" sends it
# through Resend (resend.com); its test sender only delivers to the address
# the Resend account was made with.
MAIL_DRIVER=console
# Where the emails go. Empty means ADMIN_EMAIL.
MAIL_TO=
# Only for resend
RESEND_API_KEY=
MAIL_FROM=Portfolio <onboarding@resend.dev>

# How many proxies (load balancer, CDN) sit in front of the app. The contact
# form's per-visitor limit reads the visitor's address that many entries from
# the end of x-forwarded-for, where a visitor can't fake it. 1 is right locally
# and behind a single load balancer; CloudFront in front of a load balancer is 2.
TRUSTED_PROXIES=1

# Only when running more than one server: the same key on every server, so a
# page served by one can call server actions on another. Next.js generates
# one per build otherwise. Generate like BETTER_AUTH_SECRET.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
