# Copy to .env.local and fill in. .env.local is never committed.

# Postgres. Locally: the docker-compose.yml database. In production: the RDS
# database and user created for this site.
DATABASE_URL=postgres://peyyala:peyyala@localhost:5432/peyyala

# Admin sign-in (Better Auth + Google)
# A long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different one in production, and keep it secret.
BETTER_AUTH_SECRET=
# The site's own address: http://localhost:3000 locally, https://peyyala.com live
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account allowed into the admin
ADMIN_EMAIL=
